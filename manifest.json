{
    "manifest_version": 3,
    "name": "Infinity New Tab",
    "version": "3.6.3",
    "description": "二次元新标签页：一屏看完的书签目录、常访问网站、视频与在线壁纸，以及 HDR 屏幕上的玻璃高光。",
    "minimum_chrome_version": "141",
    "permissions": [
        "storage",
        "tabs",
        "downloads",
        "history",
        "favicon"
    ],
    "host_permissions": [
        "https://www.dmoe.cc/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'self' https://www.dmoe.cc;"
    },
    "chrome_url_overrides": {
        "newtab": "newtab.html"
    },
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    }
}
