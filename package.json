{
  "name": "infinity-newtab-extension",
  "version": "3.2.0",
  "description": "TypeScript 与原生 Web Components 打造的二次元 Chrome 新标签页，书签目录、动态壁纸与 Liquid Glass HDR。",
  "scripts": {
    "build": "esbuild src/app.ts --bundle --format=iife --target=chrome120 --outfile=modules/app.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run typecheck && npm run test:unit && npm run test:e2e",
    "test:unit": "esbuild tests/unit-entry.ts --bundle --platform=node --format=cjs --target=node22 --outfile=test-results/unit.cjs && node test-results/unit.cjs",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kekincai/infinity-newtab-extension.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/kekincai/infinity-newtab-extension/issues"
  },
  "homepage": "https://github.com/kekincai/infinity-newtab-extension#readme",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
